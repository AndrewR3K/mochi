{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@lite3d/vue": ["../../packages/vue/src/index.ts"],
      "@lite3d/vue/*": ["../../packages/vue/src/*"],
      "@lite3d/gameplay": ["../../packages/gameplay/src/index.ts"],
      "@lite3d/gameplay/*": ["../../packages/gameplay/src/*"],
      "@lite3d/renderer-webgl": ["../../packages/renderer-webgl/src/index.ts"],
      "@lite3d/renderer-webgl/*": ["../../packages/renderer-webgl/src/*"],
      "@lite3d/core": ["../../packages/core/src/index.ts"],
      "@lite3d/core/*": ["../../packages/core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
