{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@lite3d/engine-vue": ["../../packages/engine-vue/src/index.ts"],
      "@lite3d/engine-vue/*": ["../../packages/engine-vue/src/*"],
      "@lite3d/game": ["../../packages/game/src/index.ts"],
      "@lite3d/game/*": ["../../packages/game/src/*"],
      "@lite3d/render-webgl": ["../../packages/render-webgl/src/index.ts"],
      "@lite3d/render-webgl/*": ["../../packages/render-webgl/src/*"],
      "@lite3d/runtime": ["../../packages/runtime/src/index.ts"],
      "@lite3d/runtime/*": ["../../packages/runtime/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
