{
  "name": "mochi",
  "version": "0.2.0-alpha.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "dev:starter": "pnpm --filter alpha-starter dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "pnpm --filter playground build && pnpm --filter alpha-starter build",
    "test": "node --import tsx --test \"packages/**/test/**/*.test.ts\"",
    "version:bump": "node scripts/bump-version.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck && pnpm exec tsc -p tsconfig.test.json --noEmit",
    "verify": "pnpm version:check && pnpm typecheck && pnpm test && pnpm build && pnpm docs:build",
    "security:audit": "pnpm audit --audit-level=high"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "tsx": "4.21.0",
    "typescript": "~5.7.2",
    "vitepress": "^1.6.4"
  }
}
